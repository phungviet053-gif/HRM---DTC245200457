# Copy this file to .env and replace each password with a unique 32+ character
# alphanumeric secret. Do not commit .env.
POSTGRES_PASSWORD=replace_with_unique_admin_secret
DB_PASSWORD=replace_with_unique_app_secret
DB_MONITOR_PASSWORD=replace_with_unique_monitor_secret
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=replace_with_unique_pgadmin_secret
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace_with_unique_grafana_secret
HTTP_PORT=8080
